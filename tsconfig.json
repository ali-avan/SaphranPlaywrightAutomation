{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "outDir": "dist",
    "types": ["node", "playwright", "@cucumber/cucumber"],
    "baseUrl": ".",               // root for path aliases
    "paths": {
      "@steps/*": ["step-definitions/*"],
      "@support/*": ["support/*"],
      "@utils/*": ["utils/*"],
      "@pages/*": ["pages/*"]
    }
  },
  "include": ["**/*.ts"]
}
